# Indirizzo del modulo WiNet nella tua rete (obbligatorio)
STUFA_URL=http://192.168.1.50
# Database MySQL/MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stufa
DB_USER=stufa
DB_PASSWORD=
# Frequenza di lettura (secondi)
POLL_FAST_S=5
POLL_SLOW_S=60
SLOW_CATS=2,3
SNAPSHOT_S=3600
# Pagina web
WEB_HOST=0.0.0.0
WEB_PORT=8095
TZ_LOCALE=Europe/Rome
# Facoltativo: token del cloud Thermorossi, solo per leggere GetStatus/GetPower
THERMOROSSI_TOKEN=
CLOUD_POLL_S=60
